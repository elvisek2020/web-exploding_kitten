# Zkopíruj jako .env (vedle docker-compose.yml) a vyplň.
# Soubor .env je v .gitignore i .dockerignore - heslo se nedostane
# do repozitáře ani do Docker image.

# Heslo pro admin režim Super Power (/super_power).
# Bez nastaveného hesla je admin režim vypnutý.
ADMIN_PASSWORD=

# Volitelné (výchozí hodnoty viz README)
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=https://kotatka.example.com
# FORWARDED_ALLOW_IPS=172.20.0.1
# DISCONNECT_GRACE_SECONDS=15
